{
  "name": "web-terminal-mainframe",
  "version": "1.0.0",
  "description": "Web-based 3270 mainframe terminal via c3270",
  "main": "dist/server.js",
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --packages=external --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && node dist/server.js",
    "start:prod": "npm run build && cross-env DEFAULT_SERVER=prod node dist/server.js",
    "start:dev": "npm run build && cross-env DEFAULT_SERVER=dev node dist/server.js",
    "start:local": "npm run build && cross-env DEFAULT_SERVER=local node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:prod": "cross-env DEFAULT_SERVER=prod tsx watch src/server.ts",
    "dev:dev": "cross-env DEFAULT_SERVER=dev tsx watch src/server.ts",
    "dev:local": "cross-env DEFAULT_SERVER=local tsx watch src/server.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.18.2",
    "node-pty": "^1.0.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.21.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
